[Unit]
Description=Run Clever crawler every 15 min (peak) or 60 min (off-peak)

[Timer]
# Peak hours: every 15 minutes from 07:00 to 22:00
OnCalendar=07..22:00/15
# Off-peak hours: every 60 minutes from 22:00 to 07:00
OnCalendar=22..23:00/60
OnCalendar=00..06:00/60
AccuracySec=30s
# Re-run on next opportunity if the system was down when the timer fired.
Persistent=true
Unit=crawler-clever.service

[Install]
WantedBy=timers.target
